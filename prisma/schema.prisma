generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  password      String
  avatar        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  playlists       Playlist[]
  favorites       Favorite[]
  reproductions   Reproduction[]
  podcasts        Podcast[]
  followedArtists Follow[]
  podcastRatings  PodcastRating[]
  podcastComments PodcastComment[]
}

model Artist {
  id        String   @id @default(cuid())
  name      String
  image     String?
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  songs   Song[]
  albums  Album[]
  follows Follow[]
}

model Follow {
  id        String   @id @default(cuid())
  userId    String
  artistId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([userId, artistId])
}

model Album {
  id        String   @id @default(cuid())
  title     String
  image     String?
  year      Int?
  artistId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  songs  Song[]
}

model Song {
  id        String   @id @default(cuid())
  title     String
  duration  Int       // seconds
  url       String?   // audio URL
  image     String?
  artistId  String
  albumId   String?
  genre     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  artist       Artist       @relation(fields: [artistId], references: [id], onDelete: Cascade)
  album        Album?       @relation(fields: [albumId], references: [id], onDelete: SetNull)
  playlistItems PlaylistSong[]
  favorites    Favorite[]
  reproductions Reproduction[]
}

model Playlist {
  id          String   @id @default(cuid())
  title       String
  description String?
  image       String?
  isPublic    Boolean  @default(true)
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  songs   PlaylistSong[]
}

model PlaylistSong {
  id         String @id @default(cuid())
  playlistId String
  songId     String
  position   Int
  addedAt    DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  song     Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([playlistId, songId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  songId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([userId, songId])
}

model Reproduction {
  id               String   @id @default(cuid())
  userId           String
  songId           String?
  episodeId        String?
  progress         Int      @default(0)  // seconds listened
  completed        Boolean  @default(false)
  createdAt        DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  song    Song?    @relation(fields: [songId], references: [id], onDelete: SetNull)
  episode Episode? @relation(fields: [episodeId], references: [id], onDelete: SetNull)
}

model Podcast {
  id          String   @id @default(cuid())
  title       String
  description String?
  image       String?
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  episodes Episode[]
  ratings  PodcastRating[]
  comments PodcastComment[]
}

model PodcastRating {
  id        String   @id @default(cuid())
  userId    String
  podcastId String
  value     Int      // 1 a 5
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@unique([userId, podcastId])
}

model PodcastComment {
  id        String   @id @default(cuid())
  userId    String
  podcastId String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)
}

model Episode {
  id               String   @id @default(cuid())
  title            String
  description      String?
  duration         Int      // seconds
  url              String?  // audio URL
  image            String?
  podcastId        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  podcast       Podcast        @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  reproductions Reproduction[]
  categories    EpisodeCategory[]
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  episodes EpisodeCategory[]
}

model EpisodeCategory {
  id         String @id @default(cuid())
  episodeId  String
  categoryId String

  episode  Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([episodeId, categoryId])
}

model Genre {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
