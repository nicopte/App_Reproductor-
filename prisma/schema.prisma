generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  password      String
  avatar        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  playlists       Playlist[]
  favorites       Favorite[]
  reproductions   Reproduction[]
  podcasts        Podcast[]
  podcastRatings  PodcastRating[]
  podcastComments PodcastComment[]
}

model Playlist {
  id          String   @id @default(cuid())
  title       String
  description String?
  image       String?
  isPublic    Boolean  @default(true)
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  episodes PlaylistEpisode[]
}

model PlaylistEpisode {
  id         String   @id @default(cuid())
  playlistId String
  episodeId  String
  position   Int
  addedAt    DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  episode  Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([playlistId, episodeId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  episodeId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
}

model Reproduction {
  id        String   @id @default(cuid())
  userId    String
  episodeId String
  progress  Int      @default(0) // seconds listened
  completed Boolean  @default(false)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
}

model Podcast {
  id          String   @id @default(cuid())
  title       String
  description String?
  image       String?
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  episodes Episode[]
  ratings  PodcastRating[]
  comments PodcastComment[]
}

model PodcastRating {
  id        String   @id @default(cuid())
  userId    String
  podcastId String
  value     Int      // 1 a 5
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@unique([userId, podcastId])
}

model PodcastComment {
  id        String   @id @default(cuid())
  userId    String
  podcastId String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)
}

model Episode {
  id          String   @id @default(cuid())
  title       String
  description String?
  duration    Int      // seconds
  url         String?  // audio URL
  image       String?
  podcastId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  podcast       Podcast           @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  reproductions Reproduction[]
  categories    EpisodeCategory[]
  favorites     Favorite[]
  playlistItems PlaylistEpisode[]
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  episodes EpisodeCategory[]
}

model EpisodeCategory {
  id         String @id @default(cuid())
  episodeId  String
  categoryId String

  episode  Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([episodeId, categoryId])
}
