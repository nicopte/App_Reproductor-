# --- Database (Neon PostgreSQL) ---
# Get this from your Neon project dashboard -> Connection string
# (use the "pooled connection" string for serverless/Vercel deployments)
DATABASE_URL="postgresql://user:password@your-neon-host.neon.tech/dbname?sslmode=require"

# --- Sessions ---
# Random string, at least 32 characters. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-secret"

# --- Cloudinary ---
# From your Cloudinary dashboard -> Account details
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# --- Vercel Blob (podcast episode audio) ---
# Create a Blob store in your Vercel project (Storage tab) and it will
# auto-populate this env var for you on Vercel. For local dev, copy the
# token from Storage -> your Blob store -> .env.local tab.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"
